# Copy to .env — never commit .env

# PostgreSQL (Neon) — pooled connection for runtime
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Non-pooled URL — required for prisma migrate on Neon
DIRECT_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Clerk Dashboard → API Keys → Secret key (backend only)
CLERK_SECRET_KEY=your_clerk_secret_key_from_dashboard

# Do NOT put VITE_CLERK_PUBLISHABLE_KEY here — use sayloop-frontend/.env.local instead

# HTTP + WebSocket port
PORT=4000

# Primary frontend origin (no trailing slash). In dev, 5173 AND 5174 are allowed automatically.
# Prod: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173
# Optional extra origins (comma-separated): http://localhost:5174
# FRONTEND_URLS=http://localhost:5174

# development | production (production enforces required vars in env.js)
NODE_ENV=development

# Optional — AI nickname suggestions (modules/ai/nameService.js)
GEMINI_API_KEY=

# Optional — listed in dependencies but unused in source
OPENAI_API_KEY=
