# Copy to .env.local for local development (preferred over .env)
# Clerk: https://dashboard.clerk.com/~/api-keys → React publishable key
# Enable Google OAuth + redirect URLs: /sso-callback, /onboarding

# Copy the full key from Clerk — do not remove the last character (often ends in Q)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_Y2FwYWJsZS1tYWtvLTUxLmNsZXJrLmFjY291bnRzLmRldiQ

# Backend — MUST be local in dev (do NOT use replit/old URLs — causes 504)
VITE_API_URL=http://localhost:4000

# Socket.IO — same host as API in dev
VITE_SOCKET_URL=http://localhost:4000
