# Copy to .env.local for local dev (not used on Vercel production build)

VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# --- Local dev (recommended): direct socket + API to backend :4000 ---
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000

# --- Alternative: leave unset + VITE_USE_DEV_PROXY=true → proxy via Vite :5173 ---

# --- Deployed (also in .env.production for Vercel builds) ---
# Frontend: http://sayloop-henna.vercel.app
# API:      https://sayloop.ddns.net
# VITE_API_URL=https://sayloop.ddns.net
# VITE_SOCKET_URL=https://sayloop.ddns.net
