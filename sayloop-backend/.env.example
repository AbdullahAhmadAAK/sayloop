# Copy to .env — never commit .env

DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
DIRECT_URL=postgresql://user:password@host/neondb?sslmode=require

CLERK_SECRET_KEY=sk_live_or_test_xxxxxxxx

PORT=4000
NODE_ENV=production

# Deployed frontend (Vercel) — no trailing slash
FRONTEND_URL=http://sayloop-henna.vercel.app
FRONTEND_URLS=https://sayloop-henna.vercel.app,http://sayloop-henna.vercel.app

# *.vercel.app previews (default on). Set false to lock down to FRONTEND_URL only.
# ALLOW_VERCEL_PREVIEWS=true

GEMINI_API_KEY=

# Required for Review / Whisper + coach notes (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-xxxxxxxx
